# ==============================================================================
# ALIBI PROTOCOL — MAINNET FRONTEND CONFIGURATION (.env.mainnet)
#
# Copy this file to .env.mainnet (git-ignored) or .env
# ==============================================================================

# ---- Network & Explorer Settings (QIE Mainnet) ----
VITE_CHAIN_ID=1990
VITE_CHAIN_NAME=QIE Blockchain Mainnet
VITE_RPC_URL=https://rpc1mainnet.qie.digital/
VITE_EXPLORER_URL=https://mainnet.qie.digital
VITE_NATIVE_SYMBOL=QIE
VITE_NATIVE_DECIMALS=18

# ---- Relayer API ----
VITE_API_URL=http://localhost:8787

# ---- Deployed Contract Addresses (synced from deployments/1990.json) ----
VITE_VERIFIER_ADDRESS=
VITE_REGISTRY_ADDRESS=
VITE_ESCROW_ADDRESS=
VITE_ROUTER_ADDRESS=
VITE_VAULT_ADDRESS=

# ---- Optional Stable Asset (QUSDC) ----
# Leave unset until verified from official QIE docs
VITE_QUSDC_ADDRESS=

# ---- Demo Merchant (empty on mainnet) ----
VITE_DEMO_MERCHANT=

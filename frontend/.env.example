# Which chain this build talks to. Testnet first.
VITE_CHAIN_ID=1983
VITE_RPC_URL=https://rpc2testnet.qie.digital/
VITE_EXPLORER_URL=https://testnet.qie.digital

# The Alibi relayer (backend)
VITE_API_URL=http://localhost:8787

# Contract addresses: `node scripts/sync-deployment.mjs <chainId>` fills these from deployments/<chainId>.json
VITE_REGISTRY_ADDRESS=
VITE_ESCROW_ADDRESS=
VITE_ROUTER_ADDRESS=
VITE_VAULT_ADDRESS=

# Optional: an ERC-20 settlement asset (e.g. QUSDC). Leave empty to use native QIE only.
VITE_QUSDC_ADDRESS=

# Optional: prefilled merchant address for the Judge sandbox
VITE_DEMO_MERCHANT=
